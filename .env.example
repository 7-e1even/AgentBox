# 复制为 .env 后可覆盖 Compose 默认值。长期或生产部署务必修改数据库密码。
POSTGRES_DB=agentbox
POSTGRES_USER=agentbox
# 警告：默认值 change-me-before-deploy 仅限本机体验，任何网络可达的部署都必须改为强随机
# 密码（Server 检测到默认值会告警）。该值仅在数据库卷首次初始化时生效，已有数据时修改
# 不会同步更新数据库内密码，操作前请参考 README“备份与恢复”。
POSTGRES_PASSWORD=change-me-before-deploy

# 生产环境建议固定到 GitHub Release 标签，例如 v0.1.0；不设置时拉取 latest。
# AGENTBOX_VERSION=v0.1.0

# 构建 Go 镜像使用的模块代理；无法访问官方代理时可替换为可信镜像源。
GOPROXY=https://proxy.golang.org,direct

# 浏览器和 Linux Worker 都通过这个统一入口访问 AgentBox。
AGENTBOX_PORT=3000
AGENTBOX_PUBLIC_URL=http://localhost:3000
AGENTBOX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 仅在 AgentBox 需要连接可信内网模型网关时开启。
AGENTBOX_ALLOW_PRIVATE_PROVIDER_ENDPOINTS=false

# 位于反向代理之后（由代理终结 TLS）时设为 true，Server 才会信任 X-Forwarded-* 头。
# AGENTBOX_TRUSTED_PROXY=false
