DATABASE_URL=postgresql://agentbox:change-me@localhost:5432/agentbox
PORT=8091
AGENTBOX_BIND_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 可选：base64 编码的 32 字节主密钥；未配置时会自动生成 .agentbox-secret-key。
AGENTBOX_SECRET_KEY=
# 可选：仅在需要连接可信内网模型网关时启用。
AGENTBOX_ALLOW_PRIVATE_PROVIDER_ENDPOINTS=false
# 可选：仅限本地调试。两项必须同时设置；生产环境不会允许关闭登录。
AGENTBOX_ENV=production
AGENTBOX_DISABLE_AUTH=false
